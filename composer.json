{
    "name": "root/app",
    "type": "project",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Test\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.5",
        "symfony/console": "^8.0",
        "webmozart/assert": "^2.3"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.1",
        "squizlabs/php_codesniffer": "^4.0",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "scripts": {
        "lint": "php-cs-fixer check --using-cache=no",
        "phpcs": "phpcs src bin",
        "phpstan": "phpstan analyse src bin --level=max",
        "test": "phpunit --colors=always",
        "test-coverage": "phpunit --colors=always --coverage-text"
    }
}
