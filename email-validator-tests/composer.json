{
    "$schema": "https://getcomposer.org/schema.json",
    "type": "project",
    "description": "The skeleton application for the OTUS home work.", 
    "license": "MIT",
    "require": {
        "php": "^8.2"        
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"          
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"           
        }
    },
    "scripts": {        
    },
    "extra": {       
    },
    "config": {        
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    }
}
