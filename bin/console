#!/usr/bin/env php
<?php

require __DIR__ . '/../vendor/autoload.php';

use App\Console\TestMapperCommand;
use App\DataMapper\EntityManager;
use App\DataMapper\Mapping\MetadataReader;
use App\Example\PetRepository;
use App\Example\ProfileRepository;
use App\Example\UserRepository;
use Symfony\Component\Console\Application;

$application = new Application();

$host = '127.0.0.1';
$db   = 'mapper';
$user = 'admin';
$pass = 'secret';
$port = '5432';

$dsn = "pgsql:host=$host;dbname=$db;port=$port";
$pdo = new PDO($dsn, $user, $pass);
$metadataReader = new MetadataReader();
$entityManager = new EntityManager($pdo, $metadataReader);
$userRepository = new UserRepository($entityManager);
$profileRepository = new ProfileRepository($entityManager);
$petRepository = new PetRepository($entityManager);

$application->addCommand(new TestMapperCommand($userRepository, $profileRepository, $petRepository));

$application->run();
