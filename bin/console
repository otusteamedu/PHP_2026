#!/usr/bin/env php
<?php

require __DIR__ . '/../vendor/autoload.php';

use App\DataMapper\EntityManager;
use App\DataMapper\Mapping\MetadataReader;
use App\Example\Infrastucture\Console\TestMapperCommand;
use App\Example\Infrastucture\Repository\HouseRepositoryInterface;
use App\Example\Infrastucture\Repository\PetRepository;
use App\Example\Infrastucture\Repository\ProfileRepository;
use App\Example\Infrastucture\Repository\UserPetRepository;
use App\Example\Infrastucture\Repository\UserRepository;
use Symfony\Component\Console\Application;

$application = new Application();

$host = 'postgres';
$db   = 'mapper';
$user = 'admin';
$pass = 'secret';
$port = '5432';

$dsn = "pgsql:host=$host;dbname=$db;port=$port";
$pdo = new PDO($dsn, $user, $pass);
$metadataReader = new MetadataReader();
$entityManager = new EntityManager($pdo, $metadataReader);
$userRepository = new UserRepository($entityManager);
$profileRepository = new ProfileRepository($entityManager);
$petRepository = new PetRepository($entityManager);
$houseRepository = new HouseRepositoryInterface($entityManager);
$userPetRepository = new UserPetRepository($entityManager);

$application->addCommand(new TestMapperCommand(
    $userRepository,
    $profileRepository,
    $petRepository,
    $houseRepository,
    $userPetRepository
));

$application->run();
