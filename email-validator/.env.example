APP_NAME="OtusDocker"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8080
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAIL_ADDRESS=example@mail.ru

#DOCKER
DOCKER_USER=WORKER
APP_PATH=/var/www/app
APP_WEB_PORT=8080
